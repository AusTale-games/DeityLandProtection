Button #Button {
  LayoutMode: Left;
  Padding: (Full: 6);
  Anchor: (Height: 80);
  Style: (
    Hovered: (
      Background: #000000(0.2),
    )
  );

  ItemIcon #Icon {
    Anchor: (Width: 32, Height: 32);
  }

  Group {
    LayoutMode: Top;
    FlexWeight: 1;

    Label #Name {
      Padding: (Horizontal: 10, Vertical: 2);
      Style: (RenderBold: true);
    }

    Label #Durability {
      Padding: (Horizontal: 10, Vertical: 2);
      Style: (TextColor: #ffffff(0.6));
    }
  }
}
